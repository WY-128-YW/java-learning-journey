class Solution {
    public String longestCommonPrefix(String[] strs) {
      int length=strs[0].length();
      int count=strs.length;
      for(int i=0;i<length;i++){
        char currt=strs[0].charAt(i);//strs数组中第一个字符串的第i个元素
      for(int j=1;j<count;j++){
        if(i==strs[j].length()||strs[j].charAt(i)!=currt){
            return strs[0].substring(0,i);//返回strs数组中第一个字符串从第0个到第i个元素的子字符串
        }
       }
      }
      return strs[0];
}
}
