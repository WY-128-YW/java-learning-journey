class Solution {
    public int singleNumber(int[] nums) {
        Arrays.sort(nums);//对数组从小到大排序
        int slow=0;int fast=1;//定义快慢指针
        while(fast<nums.length){
            if(nums[slow]==nums[fast]){
                //是一对相等的数，跳过这两个数
                 slow+=2;fast+=2;
            }else{
                return nums[slow];//找到落单元素，slow指向它
            }
        }
        return nums[slow];
    }
}

